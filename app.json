{
  "expo": {
    "name": "Pak Shutter",
    "slug": "pak-shutter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#0F2C4C",
    "description": "Pak Shutter - rolling shutters, automatic shutters, repair, maintenance and custom metal works in Karachi.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pakshutter.app"
    },
    "android": {
      "package": "com.pakshutter.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F2C4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F2C4C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pak Shutter to choose photos so the admin can update services and gallery.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}